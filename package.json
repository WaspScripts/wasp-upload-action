{
	"name": "wasp-upload-action",
	"version": "2.0.0",
	"description": "GitHub Action to compile test and upload Simba scripts to waspscripts.com",
	"type": "module",
	"private": true,
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"package": "ncc build lib/index.js -o dist --source-map --license licenses.txt",
		"all": "pnpm run build && pnpm run package",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"keywords": [],
	"author": "Torwent",
	"license": "GPL-3.0-or-later",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@supabase/supabase-js": "^2.117.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@types/node": "^24.0.0",
		"@vercel/ncc": "^0.45.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.0",
		"prettier": "^3.9.9",
		"typescript": "~6.0.3",
		"typescript-eslint": "~8.70.1"
	}
}
